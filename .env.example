# ── Platform secrets (one bill for the agency, shared across all clients) ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ── Per-client secrets referenced as ${VAR} inside clients/*/config.yaml ──
# NaviGo (tenant #1)
WP_USERNAME=your_wordpress_username_here
WP_APP_PASSWORD=your_wordpress_app_password_here
INDEXNOW_KEY=your_indexnow_key_here

