# Copy to .env and fill in.
# ═══ AutoBlog Engine settings ═══════════════════════════════════════════
# Lines starting with # are switched off. Never commit this file.

# ── Required (both free) ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://unsplash.com/developers (your app's Access Key)
UNSPLASH_ACCESS_KEY=

# Optional, free: research papers for articles. https://openalex.org/settings/api
OPENALEX_API_KEY=

# ── Where articles go ──
# strapi | wordpress | files (files = save only, never publish).
# Empty = use the client's config.yaml (publish_to), or whichever CMS is set up.
PUBLISH_TO=
# draft | published — how uploaded articles land in Strapi/WordPress (draft = review, then publish).
# Empty = use the client's config.yaml (strapi.status / wordpress.status).
PUBLISH_STATUS=

# Strapi: Settings > API Tokens (find, findOne, create, update on the blog collection + Upload upload)
STRAPI_API_TOKEN=

# WordPress (only if a client uses it): Users > Profile > Application Passwords
# WP_USERNAME=
# WP_APP_PASSWORD=

# ── Schedule ──
# Articles per month, and the weekdays to post on (mon,tue,wed,thu,fri,sat,sun)
POSTS_PER_MONTH=8
PUBLISH_DAYS=tue,fri
# Daily check time and its timezone (the server clock may be UTC)
SCHEDULE_TIME=09:07
SCHEDULE_TZ=Asia/Kolkata
# 1 = also run once as soon as the app/container starts
RUN_ON_START=0

# ── Docker web page: which client it shows ──
CLIENT=acme

# ── Advanced (optional) ──
# Gemini models to try, in order
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-2.5-flash-lite
